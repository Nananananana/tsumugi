[importlinter]
include_external_packages = True
root_packages =
    tsumugi

# The direction, asserted. The stdlib-only rule for the domain is a separate
# check in tests/test_architecture.py, because import-linter cannot express
# "everything except the standard library".
[importlinter:contract:layers]
name = Layer dependency direction
type = layers
layers =
    tsumugi.interfaces
    tsumugi.evaluation
    tsumugi.application
    tsumugi.infrastructure
    tsumugi.ports
    tsumugi.domain
exhaustive = false

[importlinter:contract:domain-purity]
name = The domain layer knows nothing below it
type = forbidden
source_modules =
    tsumugi.domain
forbidden_modules =
    tsumugi.ports
    tsumugi.application
    tsumugi.infrastructure
    tsumugi.interfaces
    tsumugi.evaluation

# ADR-0001 and ADR-0016: the network lives in exactly one place,
# infrastructure/adapters/, and nothing else may reach it. Listing the
# infrastructure packages one by one rather than excluding adapters is
# deliberate -- a new one has to be added here, which is the same maintenance
# obligation as the layer table and the same reason for it.
[importlinter:contract:no-network]
name = Nothing but the adapters touches the network
type = forbidden
source_modules =
    tsumugi.domain
    tsumugi.ports
    tsumugi.application
    tsumugi.infrastructure.cost
    tsumugi.infrastructure.filesystem
    tsumugi.infrastructure.freshness
    tsumugi.infrastructure.index
    tsumugi.infrastructure.parsers
    tsumugi.infrastructure.storage
    tsumugi.evaluation
forbidden_modules =
    socket
    ssl
    http
    urllib
    asyncio

# The core stands alone. ADR-0001, and the promise in the README that a user
# who wants only a context builder gets one.
[importlinter:contract:siblings-are-optional]
name = Only the adapters may know about kiseki or mamori
type = forbidden
# Direct imports only. The rule is that no module outside
# `infrastructure/adapters/` *names* a sibling -- and the CLI does not: it
# names the adapter, which is what an adapter is for. Without this the
# contract followed `cli.main -> adapters.mamori -> mamori` and forbade the
# `--protect` flag from existing at all.
#
# What the transitive reading was reaching for -- "the CLI does not require
# mamori to be installed" -- is a runtime property that import-linter cannot
# see, because it cannot tell a module-level import from one inside a
# function. Two other checks hold it instead: `test_architecture.py` refuses
# a module-level sibling import inside an adapter, and `test_leakage.py`
# imports the whole surface in a subprocess with the siblings blocked.
allow_indirect_imports = True
source_modules =
    tsumugi.domain
    tsumugi.ports
    tsumugi.application
    tsumugi.interfaces
forbidden_modules =
    kiseki
    mamori

# The domain does its own I/O nowhere. Reading a file is the filesystem
# adapter's job; where the index lives is configuration's job.
[importlinter:contract:domain-no-io]
name = The domain layer does not touch the filesystem
type = forbidden
source_modules =
    tsumugi.domain
forbidden_modules =
    pathlib
    os
    sqlite3
    tomllib
    argparse
